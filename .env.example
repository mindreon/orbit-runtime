# Copy to .env and fill in locally. Never commit real values.

# mock (default) or real
ORBIT_MODEL_MODE=mock
# Required when ORBIT_MODEL_MODE=real
ORBIT_MODEL_BASE_URL=
ORBIT_MODEL_API_KEY=
ORBIT_MODEL_NAME=
# Optional, seconds
ORBIT_MODEL_TIMEOUT_SECONDS=

# Postgres state store; unset keeps state in memory
ORBIT_STATE_STORE_URL=
# Required with ORBIT_STATE_STORE_URL: a Fernet key (Fernet.generate_key())
ORBIT_STATE_KEY=
# Exactly 1 allows plaintext state for local development; anything else is production
ORBIT_ALLOW_PLAINTEXT_STATE=
