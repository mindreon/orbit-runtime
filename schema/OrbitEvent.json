    "TurnFailure": {
      "description": "Payload of a ``turn.failed`` event: ``{turnId, agentId, errorCode, retryable, message}``.\n\n``agent_id`` is the contract agent id (``main`` for the room agent), not\nthe session id. ``message`` is the fixed text for ``error_code``, never\nbuilt from provider or exception text.",
      "properties": {
        "agentId": {
          "title": "Agentid",
          "type": "string"
        },
        "errorCode": {
          "enum": [
            "timeout",
            "auth",
            "rate_limited",
            "provider_error",
            "config"
