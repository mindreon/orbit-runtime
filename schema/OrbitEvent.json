{
  "$defs": {
    "TurnFailure": {
      "description": "Payload of a ``turn.failed`` event. Field names are the wire names.\n\n``agentId`` is the Orbit session id: the room agent and every spawned\nworker open their own session. ``message`` is the redacted description,\nnever provider text.",
      "properties": {
        "agentId": {
          "title": "Agentid",
          "type": "string"
        },
        "errorCode": {
          "enum": [
            "timeout",
            "auth",
            "rate_limited",
            "provider_error",
            "config"
          ],
          "title": "Errorcode",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "turnId": {
          "title": "Turnid",
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "agentId",
        "errorCode",
        "retryable",
        "message"
      ],
      "title": "TurnFailure",
      "type": "object"
    }
  },
  "description": "Normalized event the worker may ingest. Control rejects unknown types.",
  "properties": {
    "event_id": {
      "default": "",
      "title": "Event Id",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "default": "",
      "title": "Job Id",
      "type": "string"
    },
    "model_mode": {
      "anyOf": [
        {
          "enum": [
            "mock",
            "real"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Mode"
    },
    "model_name": {
      "default": "",
      "title": "Model Name",
      "type": "string"
    },
    "occurred_at": {
      "default": "",
      "title": "Occurred At",
      "type": "string"
    },
    "permission_preset": {
      "default": "",
      "title": "Permission Preset",
      "type": "string"
    },
    "room_id": {
      "title": "Room Id",
      "type": "string"
    },
    "runtime": {
      "default": "agentscope",
      "title": "Runtime",
      "type": "string"
    },
    "runtime_version": {
      "default": "2.0.8",
      "title": "Runtime Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "type": {
      "enum": [
        "session.status",
        "assistant.message",
        "tool.call",
        "tool.result",
        "approval.asked",
        "usage",
        "agent.started",
        "agent.finished",
        "turn.failed"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "session_id",
    "room_id"
  ],
  "title": "OrbitEvent",
  "type": "object"
}
