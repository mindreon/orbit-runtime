{
  "$defs": {
    "ApprovalAsk": {
      "description": "What a human must decide before a parked tool call continues.",
      "properties": {
        "approval_request_id": {
          "title": "Approval Request Id",
          "type": "string"
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "approval_request_id",
        "tool_name"
      ],
      "title": "ApprovalAsk",
      "type": "object"
    },
    "DecideOutcome": {
      "additionalProperties": false,
      "description": "Small result of one decide. No AgentState and no assistant text.",
      "properties": {
        "agentId": {
          "title": "Agentid",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "reject",
            "allow-always"
          ],
          "title": "Decision",
          "type": "string"
        },
        "errorCode": {
          "anyOf": [
            {
              "enum": [
                "timeout",
                "auth",
                "rate_limited",
                "provider_error",
                "config"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorcode"
        },
        "resumeTurnId": {
          "title": "Resumeturnid",
          "type": "string"
        },
        "turnStatus": {
          "enum": [
            "continue",
            "needs_approval",
            "needs_external",
            "completed",
            "failed"
          ],
          "title": "Turnstatus",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "agentId",
        "resumeTurnId",
        "turnStatus"
      ],
      "title": "DecideOutcome",
      "type": "object"
    },
    "DecidedApproval": {
      "additionalProperties": false,
      "description": "One decide the room has accepted. ``running`` is never pruned by TTL.",
      "properties": {
        "approvalRequestId": {
          "title": "Approvalrequestid",
          "type": "string"
        },
        "decidedAt": {
          "format": "date-time",
          "title": "Decidedat",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecideOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "running",
            "done"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "approvalRequestId",
        "decidedAt",
        "state"
      ],
      "title": "DecidedApproval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "State continue-as-new keeps. E2E also preloads ``decided_approvals`` through this.",
  "properties": {
    "childWorkflowIds": {
      "items": {
        "type": "string"
      },
      "title": "Childworkflowids",
      "type": "array"
    },
    "decidedApprovals": {
      "items": {
        "$ref": "#/$defs/DecidedApproval"
      },
      "title": "Decidedapprovals",
      "type": "array"
    },
    "lastText": {
      "default": "",
      "title": "Lasttext",
      "type": "string"
    },
    "pendingApprovals": {
      "items": {
        "$ref": "#/$defs/ApprovalAsk"
      },
      "title": "Pendingapprovals",
      "type": "array"
    },
    "preset": {
      "default": "workspace-write",
      "enum": [
        "workspace-write",
        "read-only",
        "danger-full-access"
      ],
      "title": "Preset",
      "type": "string"
    },
    "roomId": {
      "title": "Roomid",
      "type": "string"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionid"
    },
    "stateVersion": {
      "default": 0,
      "title": "Stateversion",
      "type": "integer"
    },
    "status": {
      "default": "running",
      "enum": [
        "idle",
        "running",
        "awaiting_approval",
        "awaiting_external",
        "closed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "roomId"
  ],
  "title": "RoomCarryOver",
  "type": "object"
}
