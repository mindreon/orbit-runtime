{
  "$defs": {
    "ApprovalAsk": {
      "description": "What a human must decide before a parked tool call continues.",
      "properties": {
        "approval_request_id": {
          "title": "Approval Request Id",
          "type": "string"
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "approval_request_id",
        "tool_name"
      ],
      "title": "ApprovalAsk",
      "type": "object"
    },
    "ExternalCall": {
      "description": "A tool call the workflow must finish outside the agent process.",
      "properties": {
        "arguments": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "object"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "call_id"
      ],
      "title": "ExternalCall",
      "type": "object"
    }
  },
  "description": "One agent step. ``failed`` leaves the saved state at ``state_version``.",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalAsk"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "default": "",
      "title": "Error",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "timeout",
            "auth",
            "rate_limited",
            "provider_error",
            "config"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "external": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExternalCall"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_mode": {
      "default": "mock",
      "enum": [
        "mock",
        "real"
      ],
      "title": "Model Mode",
      "type": "string"
    },
    "model_name": {
      "default": "mock",
      "title": "Model Name",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "state_version": {
      "title": "State Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "continue",
        "needs_approval",
        "needs_external",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "status",
    "session_id",
    "state_version"
  ],
  "title": "TurnResult",
  "type": "object"
}
